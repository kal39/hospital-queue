APP_ENV=development
APP_PORT=8080
APP_NAME=HospitalQueue

DB_HOST=localhost
DB_PORT=5432
DB_USER=hospital_user
DB_PASSWORD=hospital_pass
DB_NAME=hospital_queue
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=300

JWT_ACCESS_SECRET=change_me_access_secret_32chars_min
JWT_REFRESH_SECRET=change_me_refresh_secret_32chars_min
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=30

# Local dev: specific origin. Hosted: set to * to allow any frontend, or comma-separate multiple URLs
CORS_ORIGINS=http://localhost:3000
# CORS_ORIGINS=*
# CORS_ORIGINS=https://your-app.vercel.app,https://your-app.railway.app

RATE_LIMIT_MAX=100
RATE_LIMIT_EXPIRY_SECONDS=60

# Email reminders (leave SMTP_HOST empty to log to console in dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=you@gmail.com
APP_URL=https://your-frontend.vercel.app

# SMS reminders (leave blank to log to console in dev; wire a real provider in pkg/sms)
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# Trello (project-management tooling only — not read by the Go app itself)
TRELLO_API_KEY=
TRELLO_API_TOKEN=
